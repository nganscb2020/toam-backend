# Sao chép file này thành .env rồi điền giá trị thật. TUYỆT ĐỐI không đưa file .env lên GitHub.

# Chế độ chạy: khi đưa lên hosting thật hãy để "production"
NODE_ENV=production

# BẮT BUỘC: chuỗi bí mật dài (>= 32 ký tự), ngẫu nhiên. Tạo bằng lệnh:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# BẮT BUỘC để tạo được tài khoản admin lần đầu (để trống = tắt chức năng tạo tài khoản).
# Đặt chuỗi dài, khó đoán. Sau khi tạo xong admin, form tạo tài khoản tự khoá lại.
ADMIN_SETUP_KEY=

# Số lớp proxy phía trước server (Render: 1; Cloudflare + Render: 2). Chạy trên máy local: bỏ trống.
TRUST_PROXY=1

# Thời hạn đăng nhập (mặc định 7 ngày)
# JWT_EXPIRES=7d

# Chỉ điền nếu có trang web KHÁC domain gọi API này (ngăn cách bằng dấu phẩy). Bình thường để trống.
# ALLOWED_ORIGINS=https://toam.vn

# Gửi email form liên hệ
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# CONTACT_EMAIL=nganscb2020@gmail.com

# Chỉ bật nếu thật sự cần thêm admin thứ 2 (xong nên tắt lại)
# ALLOW_MORE_ADMINS=true
